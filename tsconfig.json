{
	"extends": "@companion-module/tools/tsconfig/node22/recommended-esm.json",
	"compilerOptions": {
		"module": "node20",
		"moduleResolution": "node16",
		"noEmit": true,
		"strict": false,
		"noImplicitAny": false,
		"noFallthroughCasesInSwitch": false,
		"noImplicitReturns": false,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"allowJs": false
	},
	"include": ["src/**/*.ts"]
}
