{
	"name": "yamaha-rcp",
	"legacy": [
		"yamaha-scp"
	],
	"version": "4.0.0",
	"main": "dist/index.js",
	"type": "module",
	"engines": {
		"node": "^26",
		"yarn": "^4"
	},
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"package": "yarn companion-module-build",
		"package:dev": "yarn companion-module-build --dev",
		"build": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"typecheck": "tsc --noEmit",
		"lint:raw": "eslint",
		"lint": "yarn lint:raw ."
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-yamaha-rcp.git"
	},
	"license": "MIT",
	"devDependencies": {
		"@companion-module/tools": "^3.1.0",
		"@types/node": "^26.0.0",
		"eslint": "^10.12.0",
		"husky": "^9.1.0",
		"prettier": "^3.9.0",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.71.0"
	},
	"dependencies": {
		"@companion-module/base": "^2.2.0",
		"companion-module-utils": "^0.6.0"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"packageManager": "yarn@4.17.0"
}
